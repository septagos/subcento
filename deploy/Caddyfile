# Subcento Caddyfile PRODUCTION — v1.3 : paywall par route (multi-blocs x402)
# Binaire requis : caddy compilé AVEC le module :
#   xcaddy build --with github.com/algorandecosystem/caddy-x402avm
# Le module supporte plusieurs blocs x402 auto-contenus, un par route enveloppante.
# Order : /regime d'abord (0.0001), puis bloc générique tout le reste (0.002).
# except = regex ANCRÉE : découverte gratuite, tout le reste payant.

subcento.alterfield.com {
	route /regime {
		x402 {
			accept {
				pay_to 0xf6A9eFEc928D1253Be36e1Cd2f50f9b3997cB08e
				price 0.0001
				network base
			}
			facilitator_url https://facilitator.goplausible.xyz
			description "Signed market-stress verdict: deterministic cross-asset seismograph score + Jev regime label"
			mime_type application/json
		}
		reverse_proxy 127.0.0.1:5000
	}

	route {
		x402 {
			accept {
				pay_to 0xf6A9eFEc928D1253Be36e1Cd2f50f9b3997cB08e
				price 0.002
				network base
			}
			facilitator_url https://facilitator.goplausible.xyz
			description "Pre-flight transaction verification for AI agents (signed verdict, <100ms cached)"
			mime_type application/json
			except "^(|/|/health|/llms.txt|/openapi.json|/favicon.ico)$"
		}
		reverse_proxy 127.0.0.1:5000
	}

	log {
		output file /var/log/caddy/access.log
		format json
	}
}
